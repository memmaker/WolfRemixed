# Web (KNI BlazorGL) content. Textures/fonts the KNI pipeline cannot build on macOS come prebuilt
# from WolfRemixed.Web/PrebuiltContent; Tiled maps are copied raw and parsed by MapManager.

#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:BlazorGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


